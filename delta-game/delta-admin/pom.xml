<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent><groupId>com.delta</groupId><artifactId>delta-game</artifactId><version>1.0.0</version></parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>delta-admin</artifactId>
    <description>启动模块 - 唯一入口</description>
    <dependencies>
        <dependency><groupId>com.delta</groupId><artifactId>delta-system</artifactId></dependency>
        <dependency><groupId>com.delta</groupId><artifactId>delta-user</artifactId></dependency>
        <dependency><groupId>com.delta</groupId><artifactId>delta-player</artifactId></dependency>
        <dependency><groupId>com.delta</groupId><artifactId>delta-product</artifactId></dependency>
        <dependency><groupId>com.delta</groupId><artifactId>delta-order</artifactId></dependency>
        <dependency><groupId>com.delta</groupId><artifactId>delta-pay</artifactId></dependency>
        <dependency><groupId>com.delta</groupId><artifactId>delta-message</artifactId></dependency>
        <dependency><groupId>com.delta</groupId><artifactId>delta-cs</artifactId></dependency>
        <dependency><groupId>com.github.xiaoymin</groupId><artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-devtools</artifactId><optional>true</optional></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
            </plugin>
        </plugins>
        <finalName>${project.artifactId}</finalName>
    </build>
</project>
